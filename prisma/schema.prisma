generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Now that this runs on Postgres, `status` could become a real database
// enum (it couldn't on SQLite, which has no enum type). Left as a plain
// String for now to keep this migration to the single change it needs to
// be — enforced in TypeScript instead. Allowed values: APPLIED | OA |
// INTERVIEW | OFFER | REJECTED. Worth revisiting later, not required to
// get this deployed.

// TODO: decide if company/role should be their own models or stay flat.
// Flat is fine for a single-user tool — don't over-normalize this.
model Application {
  id          String   @id @default(cuid())
  company     String
  role        String
  status      String   @default("APPLIED")
  appliedDate DateTime @default(now())
  lastUpdated DateTime @updatedAt
  notes       String?

  // status: filtered by the funnel stat cards. lastUpdated: what the
  // dashboard's default sort and stale-application check both key off.
  // Index what the app actually queries by, not every column by default.
  @@index([status])
  @@index([lastUpdated])
}

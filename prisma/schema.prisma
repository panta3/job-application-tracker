generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type, so Prisma can't enforce this at the DB
// level here (would work as a real `enum` on Postgres/MySQL). Status is a
// plain String — enforce the allowed values in TypeScript instead.
// Allowed values: APPLIED | OA | INTERVIEW | OFFER | REJECTED

// TODO: decide if company/role should be their own models or stay flat.
// Flat is fine for a single-user tool — don't over-normalize this.
model Application {
  id          String   @id @default(cuid())
  company     String
  role        String
  status      String   @default("APPLIED")
  appliedDate DateTime @default(now())
  lastUpdated DateTime @updatedAt
  notes       String?

  // status: filtered by the funnel stat cards. lastUpdated: what the
  // dashboard's default sort and stale-application check both key off.
  // Index what the app actually queries by, not every column by default.
  @@index([status])
  @@index([lastUpdated])
}
